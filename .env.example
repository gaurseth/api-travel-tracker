# Travel Tracker API - Environment Configuration

# ============================================
# Authentication Mode
# ============================================

# DEV_MODE controls authentication behavior
# - true: Authentication optional (for development/testing)
# - false: Authentication required (for production)

DEV_MODE=true

# ============================================
# Google Cloud Configuration
# ============================================

# Path to Google Cloud service account credentials
# Used for: Firestore, Vision API, Firebase Auth
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Note: If deploying to Cloud Run, this is automatically provided
# and you don't need to set it manually.

# ============================================
# Firebase Configuration
# ============================================

# Firebase uses the same credentials as above (GOOGLE_APPLICATION_CREDENTIALS)
# No additional configuration needed for Firebase Admin SDK

# ============================================
# Development Notes
# ============================================

# When DEV_MODE=true, you can test the API in multiple ways:
#
# 1. No authentication (uses default test_user_123):
#    curl http://localhost:8000/trips
#
# 2. Custom user via header:
#    curl -H "X-Dev-User-ID: alice" http://localhost:8000/trips
#
# 3. Real Firebase token (optional):
#    curl -H "Authorization: Bearer <token>" http://localhost:8000/trips

# ============================================
# Production Settings
# ============================================

# For production deployment:
# 1. Set DEV_MODE=false
# 2. Ensure GOOGLE_APPLICATION_CREDENTIALS is set
# 3. Use real Firebase tokens for all requests
